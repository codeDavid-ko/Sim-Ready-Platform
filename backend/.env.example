# 복사: copy .env.example .env  (Windows) / cp .env.example .env
APP_PASSWORD=                 # 공유 비밀번호. 비우면 인증 없음(공개)
AUTH_SECRET=                  # 비우면 ~/.algo-runner/auth_secret 에 자동 생성
ALLOWED_ORIGINS=              # 외부 공개 URL(쉼표). 비우면 localhost:3000
PORT=8000
FRONTEND_PORT=3000
CLOUDFLARED_PATH=             # 비우면 PATH·WinGet 에서 자동 탐색

# Claude 를 쓸 때만(둘 중 하나):
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
